# Required: generate with: openssl rand -hex 32
ATUIN_SECRET_KEY=replace_me

# Recommended: host address to publish port 8888 on. Empty means every interface.
# Set it to the server's Tailscale IPv4 (tailscale ip -4) to make atuin
# Tailscale-only. ufw can't do this for you: Docker-published ports bypass ufw.
ATUIN_BIND_ADDR=

# Set to true temporarily to register your account, then remove and restart
# ATUIN_OPEN_REGISTRATION=true

# Optional: override the postgres password
# If you change this, also update ATUIN_DB_URI in docker-compose.yml
# ATUIN_DB_PASSWORD=atuin
